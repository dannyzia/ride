#!/bin/sh
# Pre-commit hook — lint only staged files (~3-5s)
# Blocks commit on lint errors. Type check + web export run in pre-push.
#
# Install: node scripts/install-hooks.js

set -e

echo "⏳ Pre-commit: vacuous-assertion gate (staged test files)..."
node scripts/check-vacuous-assertions.js --staged
if [ $? -ne 0 ]; then
  echo "❌ Vacuous-assertion gate failed — commit blocked."
  echo "   Placeholder assertions like expect(true).toBe(true) pin no behavior."
  exit 1
fi

echo "⏳ Pre-commit: Date-in-sql gate (staged files)..."
node scripts/check-date-in-sql.js --staged
if [ $? -ne 0 ]; then
  echo "❌ Date-in-sql gate failed — commit blocked."
  echo "   Raw JS Date objects in sql templates crash postgres.js (ISSUE-47)."
  echo "   Use DB-side now() - interval or typed drizzle operators (lt/eq/gt)."
  exit 1
fi

echo "⏳ Pre-commit: lint staged files..."

# Get staged .ts/.tsx/.js/.jsx files (only those still on disk)
# `|| true`: grep exits 1 when nothing matches (e.g. docs-only or shell-only
# commits) and set -e would otherwise kill the hook before the skip check.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No staged JS/TS files — skipping lint."
  exit 0
fi

echo "  → Linting $(echo "$STAGED_FILES" | wc -l | tr -d ' ') file(s)..."

# Set ESLINT_USE_FLAT_CONFIG directly (no cross-env dependency — that was the cold-start hang).
# Add 30s hard timeout so a stuck eslint never blocks a commit silently.
# xargs -n 40 chunks large staged lists: Windows command-line limit aborts
# single-invocation eslint runs with "The command line is too long" (fails the
# commit with exit 128 even when the code is clean). Chunks stay sequential;
# any chunk failing blocks the commit.
export ESLINT_USE_FLAT_CONFIG=false
if command -v timeout >/dev/null 2>&1; then
  echo "$STAGED_FILES" | xargs -n 40 timeout 30 npx eslint --quiet
else
  echo "$STAGED_FILES" | xargs -n 40 npx eslint --quiet
fi
if [ $? -ne 0 ]; then
  echo "❌ Lint failed — commit blocked."
  exit 1
fi

echo "✅ Pre-commit passed."
echo "   (tsc + web export run at push time — pre-push hook)"
