#!/bin/sh
# Pre-push hook — type check + native import check.
# Blocks push on type errors or Node-only imports in client-reachable code.
#
# Web export gate REMOVED (owner ruling 2026-08-31): the project has outgrown
# the Render web deployment at this stage; a full `expo export --platform web`
# per push cost 25+ min and blocked the pipeline. Restore it if web deploy
# returns (was: `npx expo export --platform web`).
#
# Install: node scripts/install-hooks.js
#
# ── HARDENING (2026-10-03) ────────────────────────────────────────────────────
# This hook carried three fragilities that pre-commit had already been hardened
# against. All three were proven, not assumed:
#
# 1. `set -e` + `cmd; if [ $? -ne 0 ]`. Under `set -e` the shell aborts AT the
#    failing command, so the handler below never runs. Verified with a minimal
#    repro: the old idiom printed nothing and exited 1, while `if ! cmd` printed
#    the handler and exited 1. The push was blocked either way — this is not a
#    gate that fails open — but the operator saw raw tool output with no
#    explanation of what failed or that a hook had declined the push. Same bug
#    class as pre-commit's flow-xcheck stage; `if ! cmd` is the house fix.
#
# 2. Bare `npx tsc`. The npx cmd-shim is the documented source of the transient
#    exit-123 spawns that pre-commit's lint stage was rewritten to route around.
#    Worse, with node_modules absent, `npx tsc` tries to fetch a package
#    literally named `tsc` from npm and PROMPTS to install it — which hangs a
#    non-interactive hook indefinitely. Now invokes typescript's own entrypoint
#    directly, behind an existence guard that fails with a fix-it message.
#
# 3. No timeout. A hung tsc blocked the push forever with no feedback. The cap
#    is deliberately generous (600s against 62s measured) because pre-commit
#    REMOVED its eslint cap precisely for killing healthy cold starts; ~10x
#    headroom bounds a pathological hang without racing a legitimate run.
#    GNU timeout exits 124 when it kills the process, reported distinctly below
#    so a timeout is never mistaken for a type error.

set -e

TSC_ENTRY="node_modules/typescript/bin/tsc"
TSC_TIMEOUT_SECONDS=600

# Run tsc with the cap when `timeout` is available; degrade to a bare run rather
# than failing a push on a machine whose coreutils lack it.
run_tsc() {
  if command -v timeout >/dev/null 2>&1; then
    timeout "$TSC_TIMEOUT_SECONDS" node "$TSC_ENTRY" --noEmit
  else
    node "$TSC_ENTRY" --noEmit
  fi
}

# Type check (full project; ~1 min measured 2026-10-03)
echo "⏳ Pre-push: type checking..."
if [ ! -f "$TSC_ENTRY" ]; then
  echo ""
  echo "❌ TypeScript not found at $TSC_ENTRY — push blocked."
  echo "   Fix: run 'npm ci' at the REPO ROOT (one workspace install covers utils-server too)."
  exit 1
fi
if run_tsc; then
  echo "✅ Type check passed."
else
  rc=$?
  echo ""
  if [ "$rc" -eq 124 ]; then
    echo "❌ Type check TIMED OUT after ${TSC_TIMEOUT_SECONDS}s — push blocked."
    echo "   Raise TSC_TIMEOUT_SECONDS in this hook if a full check legitimately takes longer."
  else
    echo "❌ Type check failed (exit $rc) — push blocked."
  fi
  exit 1
fi

# Native import safety check (fast; still guards Metro native bundles)
echo "⏳ Pre-push: native import check..."
if [ ! -f "scripts/check-web-imports.js" ]; then
  echo ""
  echo "❌ scripts/check-web-imports.js is missing — push blocked."
  echo "   Fix: restore it (git checkout -- scripts/check-web-imports.js)."
  exit 1
fi
if node scripts/check-web-imports.js; then
  echo "✅ Native import check passed."
else
  echo ""
  echo "❌ Native import check failed — push blocked."
  echo "   Fix risky imports before pushing."
  exit 1
fi

echo "✅ Pre-push checks passed."
