{
  "extends": "eslint-config-expo",
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["warn", {
      "vars": "all",
      "args": "none",
      "ignoreRestSiblings": true,
      "varsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^_"
    }]
  },
  "overrides": [
    {
      "files": ["*.js", "scripts/**/*.js", "ridebase-proxy/**/*.js"],
      "env": {
        "node": true,
        "browser": true
      }
    },
    {
      "files": ["scripts/**", "App Design/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
